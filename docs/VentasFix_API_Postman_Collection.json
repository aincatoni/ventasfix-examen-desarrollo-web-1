							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Mauricio Actualizado\",\n    \"apellido\": \"Contreras Silva\",\n    \"email\": \"mcontreras@ventasfix.cl\",\n    \"rol\": \"supervisor\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/usuarios/1",
							"host": ["{{base_url}}"],
							"path": ["usuarios", "1"]
						}
					}
				},
				{
					"name": "1.6 Eliminar Usuario por ID (200 OK)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": {
							"raw": "{{base_url}}/usuarios/2",
							"host": ["{{base_url}}"],
							"path": ["usuarios", "2"]
						}
					}
				}
			]
		},
