							"path": ["usuarios"]
						},
						"description": "Demuestra la validación de dominio exigida. Al ingresar un correo fuera de @ventasfix.cl, responde 422 Unprocessable Entity."
					}
				},
				{
					"name": "1.5 Actualizar Usuario por ID (200 OK)",
					"request": {
						"method": "PUT",
