		{
			"name": "0. Autenticación",
			"item": [
				{
					"name": "Login API (Obtener Token)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@ventasfix.cl\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://ventasfix.test/api/v1/auth/login",
							"protocol": "http",
							"host": ["ventasfix", "test"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Petición sin Token (Demuestra 401 Unauthorized)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "http://ventasfix.test/api/v1/productos",
							"protocol": "http",
							"host": ["ventasfix", "test"],
							"path": ["api", "v1", "productos"]
						}
					}
				}
			]
		},
