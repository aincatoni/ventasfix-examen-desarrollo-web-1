{
	"info": {
		"_postman_id": "ventasfix-api-examen-2026-v2",
		"name": "VentasFix API - Examen Desarrollo Web 1",
		"description": "Colección completa para pruebas en vivo de la API RESTful de VentasFix con autenticación por Bearer Tokens (Laravel Sanctum), cálculo de 19% IVA, validación de dominio @ventasfix.cl y manejo estricto de códigos HTTP (200, 201, 401, 404, 422).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://ventasfix.test/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Autenticación & Seguridad",
			"item": [
				{
					"name": "0.1 Login Exitoso (200 OK - Genera y Guarda Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"    console.log(\"✓ Token Sanctum guardado automáticamente:\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@ventasfix.cl\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						},
						"description": "Autentica al usuario con Bcrypt y genera el Bearer Token de Sanctum. Guarda el token automáticamente en la variable {{token}} de la colección."
					}
				},
				{
					"name": "0.2 Petición sin Token (Demuestra 401 Unauthorized)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/productos",
							"host": ["{{base_url}}"],
							"path": ["productos"]
						},
						"description": "Demuestra la protección de rutas. Al no enviar el Bearer Token, Laravel Sanctum responde con 401 Unauthorized."
					}
				},
				{
					"name": "0.3 Login con Credenciales Erróneas (Demuestra 401 Unauthorized)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@ventasfix.cl\",\n    \"password\": \"clave_incorrecta_999\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						},
						"description": "Prueba de autenticación fallida por contraseña errónea."
					}
				},
				{
					"name": "0.4 Usuario Autenticado /me (200 OK)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": {
							"raw": "{{base_url}}/me",
							"host": ["{{base_url}}"],
							"path": ["me"]
						}
					}
				},
				{
					"name": "0.5 Logout API (200 OK - Revoca Token)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": ["{{base_url}}"],
							"path": ["logout"]
						}
					}
				}
			]
		},
		{
