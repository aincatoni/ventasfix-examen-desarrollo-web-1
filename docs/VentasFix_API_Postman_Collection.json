						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rut\": \"18.999.888-7\",\n    \"nombre\": \"Usuario\",\n    \"apellido\": \"Invalido\",\n    \"email\": \"usuario.externo@gmail.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"rol\": \"vendedor\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/usuarios",
